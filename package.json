{
  "name": "@programbo/audiobook-kit",
  "version": "0.1.0",
  "description": "Build audiobooks (.m4b) from ordinary audio files.",
  "bin": {
    "abk": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "vp build",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "test": "vp test"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "ink": "^6.8.0",
    "react": "^19.2.4",
    "xstate": "5.32.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6",
    "@types/react": "^19.2.14",
    "@voidzero-dev/vite-plus-core": "0.2.1",
    "rolldown": "1.1.1",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.1",
    "vite-plus": "0.2.1"
  },
  "overrides": {
    "rolldown": "1.1.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
